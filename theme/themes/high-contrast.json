        "ui": "system-ui, -apple-system, 'Segoe UI', sans-serif"
      },
      "fontSize": {
        "xs": "11px",
        "sm": "12px",
        "md": "13px",
        "lg": "15px",
        "xl": "18px",
        "xxl": "22px"
      },
      "fontWeight": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      },
      "lineHeight": {
        "tight": 1.25,
        "normal": 1.5,
        "relaxed": 1.7
      },
      "letterSpacing": {
        "normal": "0",
        "wide": "0.02em"
      }
    },
    "radius": {
      "none": "0",
      "xs": "2px",
      "sm": "4px",
      "md": "6px",
      "lg": "10px",
      "xl": "16px",
      "full": "9999px"
    },
    "shadow": {
      "none": "none",
      "xs": "0 1px 2px rgba(0, 0, 0, 0.12)",
      "sm": "0 2px 6px rgba(0, 0, 0, 0.16)",
      "md": "0 8px 24px rgba(0, 0, 0, 0.20)",
      "lg": "0 16px 48px rgba(0, 0, 0, 0.28)",
      "focus": "0 0 0 2px rgba(37, 99, 235, 0.45)"
    },
    "density": {
      "scale": 1,
      "spacingUnit": "4px"
    },
    "icon": {
      "set": "mcpad",
      "size": {
        "xs": "14px",
        "sm": "16px",
        "md": "18px",
        "lg": "22px",
        "xl": "28px"
      },
      "strokeWidth": {
        "thin": 1,
        "normal": 1.5,
        "bold": 2
      }
