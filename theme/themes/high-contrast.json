          "sunken": "#000000",
          "overlay": "#141414",
          "hover": "#1c1c1c",
          "active": "#262626",
          "selected": "#003fb3"
        },
        "text": {
          "primary": "#ffffff",
          "secondary": "#e8e8e8",
          "muted": "#c0c0c0",
          "inverse": "#000000",
