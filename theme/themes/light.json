{
  "name": "MCPad Light",
  "version": 1,
  "mode": "light",
  "author": "Ivan Kosenkov",
  "description": "Default light theme of MCPad.",
  "tokens": {
    "color": {
      "primitive": {
        "gray": {
          "50": "#f7f8fa",
          "100": "#eef0f4",
          "300": "#c9ced8",
          "500": "#6b7280",
          "700": "#374151",
          "900": "#111827"
        },
        "blue": {
          "50": "#eff6ff",
          "100": "#dbeafe",
          "300": "#93c5fd",
          "500": "#3b82f6",
          "700": "#1d4ed8",
          "900": "#1e3a8a"
        },
        "red": {
          "50": "#fef2f2",
          "100": "#fee2e2",
          "300": "#fca5a5",
          "500": "#dc2626",
          "700": "#b91c1c",
          "900": "#7f1d1d"
        },
        "green": {
          "50": "#f0fdf4",
          "100": "#dcfce7",
          "300": "#86efac",
          "500": "#16a34a",
          "700": "#15803d",
          "900": "#14532d"
        },
        "amber": {
          "50": "#fffbeb",
          "100": "#fef3c7",
          "300": "#fcd34d",
          "500": "#d97706",
          "700": "#b45309",
          "900": "#78350f"
        },
        "violet": {
          "50": "#f5f3ff",
          "100": "#ede9fe",
          "300": "#c4b5fd",
          "500": "#7c3aed",
          "700": "#6d28d9",
          "900": "#4c1d95"
        }
      },
      "semantic": {
        "surface": {
          "base": "#ffffff",
          "raised": "#f7f8fa",
          "sunken": "#eef0f4",
          "overlay": "#ffffff",
          "hover": "#f1f5f9",
          "active": "#e2e8f0",
          "selected": "#dbeafe"
        },
        "text": {
          "primary": "#111827",
          "secondary": "#374151",
          "muted": "#6b7280",
          "inverse": "#ffffff",
          "link": "#1d4ed8",
          "code": "#6d28d9"
        },
        "border": {
          "default": "#c9ced8",
          "strong": "#9aa3b2",
          "subtle": "#e2e8f0",
          "focus": "#3b82f6"
