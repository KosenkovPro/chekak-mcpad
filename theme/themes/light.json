        "accent": {
          "default": "#2563eb",
          "hover": "#1d4ed8",
          "active": "#1e40af",
          "subtle": "#dbeafe",
          "on": "#ffffff"
        },
        "status": {
          "success": "#16a34a",
          "warning": "#d97706",
          "danger": "#dc2626",
          "info": "#0284c7"
        },
        "editor": {
          "bg": "#ffffff",
          "gutterBg": "#f7f8fa",
          "gutterText": "#6b7280",
          "activeLine": "#f1f5f9",
          "selection": "#bfdbfe",
          "selectionInactive": "#e0e7ff",
          "cursor": "#1d4ed8",
          "matchingBracket": "#d97706",
          "indentGuide": "#e2e8f0",
          "findMatch": "#fde68a",
          "findMatchCurrent": "#fbbf24"
        },
        "canvas": {
          "bg": "#f7f8fa",
          "grid": "#e2e8f0",
          "gridMajor": "#c9ced8",
          "nodeBg": "#ffffff",
          "nodeBorder": "#c9ced8",
          "nodeSelected": "#2563eb",
          "nodeText": "#111827",
          "edge": "#6b7280",
          "edgeLabel": "#374151",
          "groupBg": "#f1f5f9",
          "groupBorder": "#9aa3b2",
          "groupLabel": "#b45309"
        },
        "diff": {
          "added": "#dcfce7",
          "removed": "#fee2e2",
          "modified": "#fef3c7"
        }
      },
      "component": {
        "tab": {
          "bg": "#eef0f4",
          "activeBg": "#ffffff",
          "activeText": "#111827",
          "inactiveText": "#6b7280",
          "hoverBg": "#e2e8f0"
        },
        "sidebar": {
          "bg": "#f7f8fa",
          "border": "#e2e8f0",
          "text": "#374151"
        },
        "toolbar": {
          "bg": "#ffffff",
          "border": "#e2e8f0",
          "text": "#374151"
        },
        "statusbar": {
          "bg": "#f7f8fa",
          "text": "#6b7280"
        },
        "modal": {
          "overlay": "#11182766",
          "bg": "#ffffff",
          "border": "#c9ced8"
        },
        "mcp": {
          "toolRead": "#0284c7",
          "toolWrite": "#d97706",
          "toolPending": "#7c3aed",
          "badge": "#2563eb"
        }
      }
    },
    "typography": {
      "fontFamily": {
        "sans": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
        "mono": "'JetBrains Mono', 'Cascadia Code', Consolas, monospace",
        "ui": "system-ui, -apple-system, 'Segoe UI', sans-serif"
      },
      "fontSize": {
        "xs": "11px",
        "sm": "12px",
        "md": "13px",
        "lg": "15px",
        "xl": "18px",
        "xxl": "22px"
      },
      "fontWeight": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      },
      "lineHeight": {
        "tight": 1.25,
        "normal": 1.5,
        "relaxed": 1.7
      },
      "letterSpacing": {
        "normal": "0",
        "wide": "0.02em"
      }
    },
    "radius": {
      "none": "0",
      "xs": "2px",
      "sm": "4px",
      "md": "6px",
      "lg": "10px",
      "xl": "16px",
      "full": "9999px"
    },
    "shadow": {
      "none": "none",
      "xs": "0 1px 2px rgba(0, 0, 0, 0.12)",
      "sm": "0 2px 6px rgba(0, 0, 0, 0.16)",
      "md": "0 8px 24px rgba(0, 0, 0, 0.20)",
      "lg": "0 16px 48px rgba(0, 0, 0, 0.28)",
      "focus": "0 0 0 2px rgba(37, 99, 235, 0.45)"
    },
    "density": {
      "scale": 1,
      "spacingUnit": "4px"
    },
    "icon": {
      "set": "mcpad",
      "size": {
        "xs": "14px",
        "sm": "16px",
        "md": "18px",
        "lg": "22px",
        "xl": "28px"
      },
      "strokeWidth": {
        "thin": 1,
        "normal": 1.5,
        "bold": 2
      }
    }
  }
}
