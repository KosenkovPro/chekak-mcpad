# Cargo.lock is committed for the workspace and its binaries.
# Node / frontend
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# Rust build artefacts
/target/
target/
**/*.rs.bk
rustc-ice-*.txt
*.pdb

# Tauri
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Icons that belong to their authors. They are downloaded from the source
# repository, see scripts/icons.manifest.json and npm run icons:install.
apps/desktop/src/icons/vendor/
apps/desktop/src-tauri/icons/
scripts/app-icon.png

# MCPad service state inside a vault (never synchronised, never committed)
.mcpad/

# Logs and temporary files
*.log
*.tmp
logs/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
